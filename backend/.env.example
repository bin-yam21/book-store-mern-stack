# MongoDB connection string
# Local:  mongodb://localhost:27017/book-store
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/book-store
DB_URL=mongodb://localhost:27017/book-store

# Secret used to sign admin JWTs — use a long random string
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Port the API listens on (must match the frontend's VITE_API_URL)
PORT=5000

# Frontend origin allowed by CORS in production (e.g. https://your-store.vercel.app)
FRONTEND_URL=
